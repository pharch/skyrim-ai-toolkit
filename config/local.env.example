# Copy to config/local.env (untracked) and adapt paths locally.
# NEVER COMMIT paths revealing private user details or any API key.
# This file is private machine-local configuration. It does not grant permission
# to access the game or connect an MCP server.
SKYRIM_EDITION=AE
GAME_ROOT=
SKYRIM_EXE_PATH=
SKYRIM_EXE=
SKSE_LOADER=
# Set only for a user-selected disposable test profile/mod directory; build scripts do not deploy.
SKYRIM_OBSERVER_DEPLOYED_DLL=
# Use the selected profile's explicit active plugins.txt; keep distinct from a vanilla bridge list.
SKYRIM_PLUGIN_LIST=
SKYRIM_DATA=
SKYRIM_CONFIG_DIR=''
SKYRIM_LOADORDER_DIR=''
SKSE_CRASH_DIR=''
PLUGINS_TXT=''
RESEARCH_TEST_SAVE=''
DEVBENCH_PORT=''
APOCRYPHA_EXPORT_PATH=''

# Runtime target is separate from the GOG binary used for Ghidra static work.
# For MO2, set PLUGINS_TXT to the selected profile's explicit plugins.txt.
SSEEDIT_EXE=''
XEDIT_SCRIPTS=''
INCLUDE_CREATION_CLUB=0
MO2_PROFILE_DIR=''

# Bind the existing legacy GOG project. The query opens this project with
# -process, -noanalysis, and -readOnly; it never creates or imports a project.
LEGACY_SKYRIM_REPO=''
GHIDRA_HEADLESS_EXE=''
GHIDRA_PROJECT_DIR=''
GHIDRA_PROJECT_NAME=''
GHIDRA_PROJECT_PROGRAM='SkyrimSE.exe'
GHIDRA_ANALYSIS_EXE_GOG=''
JAVA_HOME=''
COMMONLIBSSE_ROOT=''
ADDRESS_LIBRARY_DIR=''
VCPKG_ROOT=''
UESP_DUMP_PATH=''
UESP_INDEX_PATH=.local/uesp.sqlite3
APOCRYPHA_INDEX_PATH=.local/apocrypha.sqlite3
