# Copy to config/local.env and set local paths. Keep this file untracked.
# Values are plain KEY=VALUE text; no shell expansion or environment fallback.
# This file grants no permission to launch the game, connect a server, or mutate data.

# Runtime target. SKYRIM_EXE_PATH and SKYRIM_DATA are enough for the official-
# master xEdit route; the MO2 bindings below are only for a profile-managed order.
SKYRIM_EDITION=AE
GAME_ROOT=
SKYRIM_EXE_PATH=
SKYRIM_DATA=
# Optional profile order; set only when the researched target is MO2-managed.
MO2_PROFILE_DIR=
PLUGINS_TXT=

# Separate disposable live-test lane. Leave unset unless explicitly designated.
SKYRIM_TEST_PROFILE_DIR=
SKYRIM_TEST_PLUGINS_TXT=
RESEARCH_TEST_SAVE=
SKSE_LOADER=
SKYRIM_OBSERVER_STAGED_DLL=
SKYRIM_OBSERVER_DEPLOYED_DLL=
SKYRIM_OBSERVER_LOG_DIR=
DEVBENCH_PORT=

# Existing xEdit bridge source and installed Windows tools. The helper is
# staged into ignored .local by tools/xedit_bridge.py; the source checkout stays read-only.
# The native query uses a per-session -S script directory; XEDIT_SCRIPTS is
# retained as an optional legacy compatibility binding, not a global install target.
LEGACY_SKYRIM_REPO=
SSEEDIT_EXE=
XEDIT_SCRIPTS=
# Keep zero for the official-master-only native query; CC and user plugins are excluded.
INCLUDE_CREATION_CLUB=0

# GOG-only static analysis. Keep separate from the runtime executable above.
GHIDRA_HEADLESS_EXE=
GHIDRA_PROJECT_REP_PATH=
# Required only when WSL cannot write/lock the configured source project. Use an
# absolute WSL-native path outside /mnt; the adapter caches a copy of this
# existing project there and continues to leave the source project untouched.
GHIDRA_PROJECT_CACHE_WSL=
GHIDRA_PROJECT_PROGRAM=SkyrimSE.exe
GHIDRA_ANALYSIS_EXE_GOG=
JAVA_HOME=
# Optional WSL Java 21+ home for the paired Linux Ghidra launcher.
GHIDRA_JAVA_HOME_WSL=
# Persistent Ghidra preferences/JDK selection state; keep below ignored .local/.
GHIDRA_USER_HOME_WSL=.local/ghidra-runtime/home
COMMONLIBSSE_ROOT=
ADDRESS_LIBRARY_DIR=
VCPKG_ROOT=

# Optional user-data triage folders and local source corpora.
SKYRIM_CONFIG_DIR=
PAPYRUS_LOG_DIR=
SKSE_CRASH_DIR=
UESP_DUMP_PATH=
UESP_INDEX_PATH=.local/uesp.sqlite3
APOCRYPHA_EXPORT_PATH=
APOCRYPHA_INDEX_PATH=.local/apocrypha.sqlite3

# Raw captures always remain below ignored .local/; there is no alternate root.
# Deprecated legacy keys are intentionally omitted: SKYRIM_EXE,
# SKYRIM_PLUGIN_LIST, and SKYRIM_LOADORDER_DIR.
