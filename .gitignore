# User-specific settings (contains local paths)
.codex/config.local.toml

# Local research snapshots (generated at runtime)
.research-backups/

# Node modules
node_modules/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Nexus personal API key -- NEVER commit
tools/.nexus_api_key
.nexus_api_key
*.nexus_api_key

# Python virtualenv + test caches (dev only)
.venv/
__pycache__/
.pytest_cache/

# YOUR knowledgebase, not ours. Never tracked and never shipped: the update path is
# "extract the new zip over your install", so any file the toolkit ships is replaced.
# A file that is both shipped by us and appended to by you loses your work on update.
KNOWLEDGEBASE.local.md
# Append these entries to the inherited .gitignore; do not replace upstream ignore rules.
config/local.env
research/data-private/
research/raw-private/
research/uesp-cache/
research/apocrypha-index.sqlite*
research/supervisor-logs/
.codex-local/
*.ess
*.skse
*.dmp
.research-supervisor.lock
.stop-research
